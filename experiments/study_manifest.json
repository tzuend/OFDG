  "study_design": {
    "advection_1d": {
      "question": "Do all headline methods recover optimal P1-P3 convergence for smooth periodic transport?",
      "contribution": "Primary scalar accuracy comparison and paper-style error tables.",
      "equation": "u_t + u_x = 0",
      "domain": "[0,1] periodic",
      "boundary_conditions": "periodic",
      "time_integrator": "order-controlled explicit RK; temporal-error check required",
      "metrics": ["L1", "L2", "Linf", "conservation", "runtime"],
      "reference_check": "exact translated solution and time-step halving",
      "priority": "required",
      "artifact": "separate method tables and degree-specific convergence figures",
      "status": "proposed",
      "estimated_seconds_per_run": 0.3
    },
    "advection_superconvergence": {
      "question": "Are the cell-average and downwind-point superconvergence orders retained?",
      "contribution": "Reproduction of the e4/e5 analysis in the reference papers.",
      "equation": "u_t + u_x = 0",
      "domain": "[0,1] periodic",
      "boundary_conditions": "periodic",
      "time_integrator": "high-order temporal control with Gauss-Radau initialization",
      "metrics": ["e1", "e2", "e3", "e4", "e5"],
      "reference_check": "exact translated solution and time-step halving",
      "priority": "required",
      "artifact": "paper-style e1-e5 tables",
      "status": "proposed",
      "estimated_seconds_per_run": 0.5
    },
    "burgers_smooth": {
      "question": "Is optimal accuracy retained for a nonlinear scalar flux before shock formation?",
      "contribution": "Nonlinear smooth convergence validation.",
      "equation": "u_t + (u^2/2)_x = 0",
      "domain": "[0,2pi] periodic",
      "boundary_conditions": "periodic",
      "time_integrator": "order-controlled explicit RK",
      "metrics": ["L1", "L2", "Linf", "conservation"],
      "reference_check": "characteristic exact solution and time-step halving",
      "priority": "required",
      "artifact": "separate method convergence tables",
      "status": "proposed",
      "estimated_seconds_per_run": 0.5
    },
    "euler_smooth_1d": {
      "question": "Is optimal density convergence retained for a smooth Euler system?",
      "contribution": "One-dimensional system accuracy comparison.",
      "equation": "compressible Euler",
      "domain": "[0,2pi] periodic",
      "boundary_conditions": "periodic",
      "time_integrator": "order-controlled explicit RK",
      "metrics": ["density L1", "density L2", "density Linf", "state L2", "conservation"],
      "reference_check": "exact smooth wave and time-step halving",
      "priority": "required",
      "artifact": "separate method density tables",
      "status": "proposed",
      "estimated_seconds_per_run": 1.0
